{
  "kind": "collectionType",
  "collectionName": "inventory_movements",
  "info": {
    "singularName": "inventory-movement",
    "pluralName": "inventory-movements",
    "displayName": "Inventory Movement",
    "description": "Stock movement audit log"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "sku": {
      "type": "string",
      "required": true
    },
    "warehouse": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": ["RESTOCK", "TRANSFER", "SALE", "ADJUSTMENT", "RETURN"],
      "required": true
    },
    "quantity": {
      "type": "integer",
      "required": true
    },
    "reference": {
      "type": "string"
    },
    "performedBy": {
      "type": "string",
      "default": "SYSTEM"
    }
  }
}
