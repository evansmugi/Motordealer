{
  "kind": "collectionType",
  "collectionName": "crm_tasks",
  "info": {
    "singularName": "crm-task",
    "pluralName": "crm-tasks",
    "displayName": "CRM Task",
    "description": "Managed CRM Task entity"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "parent_id": {
      "type": "string"
    },
    "subject": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "due_date": {
      "type": "datetime"
    },
    "currentStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "archived"
      ],
      "default": "pending"
    },
    "priority": {
      "type": "enumeration",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "category": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "creator_id": {
      "type": "string"
    },
    "shared_user_ids": {
      "type": "json"
    },
    "financial_weight": {
      "type": "biginteger"
    },
    "taskable_type": {
      "type": "string"
    },
    "taskable_id": {
      "type": "string"
    },
    "reminders": {
      "type": "json"
    },
    "resolution_note": {
      "type": "text"
    },
    "archive_reason": {
      "type": "text"
    },
    "archived_at": {
      "type": "datetime"
    }
  }
}