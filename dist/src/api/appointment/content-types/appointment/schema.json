{
    "kind": "collectionType",
    "collectionName": "appointments",
    "info": {
        "singularName": "appointment",
        "pluralName": "appointments",
        "displayName": "Appointment",
        "description": "Managed Appointment entity"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "client_name": {
            "type": "string",
            "required": true
        },
        "client_phone": {
            "type": "string",
            "required": true
        },
        "client_email": {
            "type": "string"
        },
        "date": {
            "type": "date",
            "required": true
        },
        "time": {
            "type": "string",
            "required": true
        },
        "budget": {
            "type": "string"
        },
        "vehicle_type": {
            "type": "string"
        },
        "use_case": {
            "type": "string"
        },
        "fuel": {
            "type": "string"
        },
        "features": {
            "type": "json"
        },
        "currentStatus": {
            "type": "enumeration",
            "enum": [
                "pending",
                "confirmed",
                "completed",
                "cancelled"
            ],
            "default": "pending"
        }
    }
}
