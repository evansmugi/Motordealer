{
    "kind": "collectionType",
    "collectionName": "car_listings",
    "info": {
        "singularName": "car-listing",
        "pluralName": "car-listings",
        "displayName": "Car Listing",
        "description": "Managed Car Listing entity"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "listing_title": {
            "type": "string",
            "required": true
        },
        "tagline": {
            "type": "string"
        },
        "price": {
            "type": "biginteger",
            "required": true
        },
        "make": {
            "type": "string",
            "required": true
        },
        "model": {
            "type": "string",
            "required": true
        },
        "condition": {
            "type": "string",
            "default": "Used"
        },
        "year": {
            "type": "string",
            "required": true
        },
        "transmission": {
            "type": "string"
        },
        "engine": {
            "type": "string"
        },
        "fuel_type": {
            "type": "string"
        },
        "mileage": {
            "type": "biginteger"
        },
        "color": {
            "type": "string"
        },
        "interior_color": {
            "type": "string"
        },
        "offer_type": {
            "type": "string"
        },
        "listing_description": {
            "type": "text"
        },
        "youtube_video_url": {
            "type": "string"
        },
        "features": {
            "type": "json"
        },
        "images": {
            "type": "json"
        },
        "currentStatus": {
            "type": "enumeration",
            "enum": [
                "Available",
                "Reserved",
                "Sold"
            ],
            "default": "Available"
        }
    }
}
